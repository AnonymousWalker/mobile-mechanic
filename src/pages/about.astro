---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

---

<Layout title="About">
  <Container>
    <div class="mt-30">
      <Sectionhead>
        <Fragment slot="title">About</Fragment>
        <Fragment slot="desc">
          Hi I'm Joseph - your local mechanic in Orlando.<br />
          With over 5 years of experience in the automotive industry, <br/> I'm dedicated to providing top-notch service to my customers with affordable prices
        </Fragment>
      </Sectionhead>
    </div>
  </Container>
</Layout>
