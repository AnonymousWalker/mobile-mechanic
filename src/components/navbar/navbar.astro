---
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from "astro-icon/components";

const menuitems = [
  {
    title: "Services",
    path: "#",
    children: [
      { title: "Oil Change", path: "#" },
      { title: "Tune Up", path: "#" },
      { title: "Repairs", path: "#" },
    ],
  },
  {
    title: "About",
    path: "/about",
  }
];
---

<header class="flex flex-col lg:flex-row justify-between items-center my-5 px-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-2xl"
          ><span class="font-bold text-[#044C7F]">JF</span>
          <span class="text-slate-500">Mechanic</span
          >
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span> {item.title}</span>
                      {item.badge && (
                        <span class="ml-1 px-2 py-0.5 text-[10px] animate-pulse font-semibold uppercase text-white bg-indigo-600 rounded-full">
                          New
                        </span>
                      )}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <!-- <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="#" size="md" block>Book Now</Link>
        </div> -->
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a 
          href="tel:321-442-5473" 
          class="flex items-center gap-2 px-4 py-2 text-white font-bold rounded-md transition-colors hover:opacity-90"
          style={`background-color: rgb(4 76 127);`}>
          <Icon class="w-5 h-5" name="bx:bxs-phone" />
          <span class="text-xl tracking-wide">407-666-3487</span>
        </a>
        <!-- <Link href="tel:407-666-3487" size="md">Book Now</Link> -->
      </div>
    </div>
  </header>
