---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Brake Service & Oil Change",
    description:
      "Stay safe on the road with expert brake inspections, repairs, and oil changes—conveniently done at your location.",
    icon: "bx:bxs-droplet",
  },
  {
    title: "Suspension & Steering",
    description:
      "Improve your car's handling and comfort with professional suspension and steering services including shocks, struts, and tie rods.",
    icon: "bx:bxs-car",
  },
  {
    title: "Diagnostics & Repair Services",
    description:
      "Check engine light on or something not right? We run full diagnostics and multi-point vehicle inspections to identify and explain issues.",
    icon: "bx:bxs-wrench",
  }
];
---

<div class="mt-16 md:mt-10">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Everything you need to get back on the road
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    We offer a wide range of services to keep your car running smoothly and safely.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
