---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Oil & Brake Services",
    description:
      "Stay safe on the road with expert brake inspections, repairs, and oil changes—conveniently done at your location.",
    icon: "bx:bxs-droplet",
  },
  {
    title: "Steering & Suspension",
    description:
      "Improve your car's handling and comfort with professional suspension and steering services including shocks, struts, and tie rods.",
    icon: "bx:bxs-car",
  },
  {
    title: "Diagnostics & Repair",
    description:
      "Check engine light on or something not right? We run full diagnostics and multi-point vehicle inspections to identify and explain issues.",
    icon: "bx:bxs-wrench",
  }
];
---

<div class="mt-16 md:mt-10">
  <h2 class="text-4xl lg:text-4xl font-bold lg:tracking-tight">
    Everything you need to get back on the road
  </h2>
  <p class="text-lg mt-4 text-slate-600 text-lg">
    We offer a wide range of services to keep your car running smoothly and safely. Ask us about any service you need.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-8">
  {
    features.map((item) => (
      <div class="group relative bg-white rounded-2xl shadow-2xl hover:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)] border border-slate-100 overflow-hidden transition-all duration-300 hover:-translate-y-1">
        <div class="p-8 flex flex-col h-full">
          <div class="flex items-center gap-4 mb-4">
            <div class="service-icon-container rounded-2xl p-3 w-12 h-12 shrink-0 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 flex items-center justify-center shadow-lg">
              <Icon class="text-white w-6 h-6" name={item.icon} />
            </div>
            <h3 class="font-bold text-2xl text-slate-900 group-hover:text-[#044C7F] transition-colors">{item.title}</h3>
          </div>
          <div class="flex-1">
            <p class="text-slate-700 leading-relaxed text-lg">{item.description}</p>
          </div>
        </div>
        <div class="absolute inset-0 bg-gradient-to-br from-transparent to-black/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
      </div>
    ))
  }
</div>

<style>
  .service-icon-container {
    background: linear-gradient(to bottom right, rgb(4, 76, 127), rgb(3, 60, 100));
  }
</style>
